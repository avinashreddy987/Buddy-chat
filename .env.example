# Example environment variables for One-to-One Chat
# Copy to .env and fill values for local development

# Server
PORT=3000

# JWT
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=8h

# Resend (optional, for sending OTP emails)
RESEND_API_KEY=

# MongoDB (optional persistence)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=chatbot

# Google OAuth
# Create OAuth 2.0 Client ID in Google Cloud Console (Web app) and paste the Client ID below
GOOGLE_CLIENT_ID=

# Development convenience: you can set local values here (do NOT commit secrets to git)
PORT=3000
JWT_SECRET=replace-this-with-a-long-random-secret
RESEND_API_KEY=replace-with-your-resend-api-key

GOOGLE_CLIENT_ID=614755398291-nihnsegjnrkpoknabum0ivh2lisfhtkq.apps.googleusercontent.com